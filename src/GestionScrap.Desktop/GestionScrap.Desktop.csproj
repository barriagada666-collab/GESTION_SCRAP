<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationIcon>..\..\installer\assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>GestionScrap</AssemblyName>
    <RootNamespace>GestionScrap.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionScrap.Application\GestionScrap.Application.csproj" />
    <ProjectReference Include="..\GestionScrap.Infrastructure\GestionScrap.Infrastructure.csproj" />
    <ProjectReference Include="..\GestionScrap.Domain\GestionScrap.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\installer\assets\app_icon.ico" LogicalName="GestionScrap.Desktop.Assets.app_icon.ico" />
    <EmbeddedResource Include="..\..\installer\assets\app_logo.png" LogicalName="GestionScrap.Desktop.Assets.app_logo.png" />
    <EmbeddedResource Include="..\..\installer\assets\cambiaso_emblem.png" LogicalName="GestionScrap.Desktop.Assets.cambiaso_emblem.png" />
    <EmbeddedResource Include="..\..\installer\assets\cambiaso_wordmark.png" LogicalName="GestionScrap.Desktop.Assets.cambiaso_wordmark.png" />
    <Content Include="..\..\installer\assets\app_icon.ico" Link="app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>

</Project>
