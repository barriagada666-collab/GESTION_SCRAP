<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>4.1.0</Version>
    <AssemblyVersion>4.1.0.0</AssemblyVersion>
    <FileVersion>4.1.0.0</FileVersion>
    <Product>Gestión de Scrap</Product>
    <Company>Cambiaso Hnos. S.A.C.</Company>
    <Description>Sistema de escritorio para gestión de scrap, control de pesajes, analítica YoY/MoM e informes operativos (.NET 10).</Description>
    <Copyright>Copyright © 2026 Cambiaso Hnos. S.A.C.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="26-11-2026" />
  </ItemGroup>
</Project>
